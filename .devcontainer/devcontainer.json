{
    "name": "Node.js Alpine Development Container",
    "dockerFile": "../Dockerfile",
    "context": "..",
    "customizations": {
      "vscode": {
        "extensions": [
          "dbaeumer.vscode-eslint",
          "esbenp.prettier-vscode"
        ]
      }
    },
    "forwardPorts": [3000],
    "postCreateCommand": "npm install",
    "remoteUser": "node"
  }
  